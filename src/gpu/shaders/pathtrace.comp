    float sinO = clamp(wo.x, -1, 1), cosO = sqrt(max(0, 1 - sinO * sinO)), phiO = atan(wo.z, wo.y), gammaT;
    vec3 ap[4];
    hairAttenuation(s, sinO, cosO, ap, gammaT);
    vec4 lobe = hairLobePDF(ap);
    float pick = random();
    int p = 0;
    for (; p < 3; ++p) {
        if (pick < lobe[p]) break;
        pick -= lobe[p];
    }
    vec2 o = p < 3 ? hairTilt(p, sinO, cosO, l) : vec2(sinO, cosO);
    float u = max(random(), 1e-5), v = l.v[p];
    float cosTheta = 1 + v * log(u + (1 - u) * exp(-2 / v));
    float sinTheta = sqrt(max(0, 1 - cosTheta * cosTheta)), cosPhi = cos(2 * PI * random());
