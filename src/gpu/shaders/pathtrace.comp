// Cuticle tilt rotates the outgoing elevation per lobe: R -2a, TT a, TRT 4a.
vec2 hairTilt(int p, float sinO, float cosO, HairLobes l) {
    vec2 r = vec2(sinO, cosO);
    if (p == 0) r = vec2(sinO * l.cos2k.y - cosO * l.sin2k.y, cosO * l.cos2k.y + sinO * l.sin2k.y);
    else if (p == 1) r = vec2(sinO * l.cos2k.x + cosO * l.sin2k.x, cosO * l.cos2k.x - sinO * l.sin2k.x);
    else if (p == 2) r = vec2(sinO * l.cos2k.z + cosO * l.sin2k.z, cosO * l.cos2k.z - sinO * l.sin2k.z);
