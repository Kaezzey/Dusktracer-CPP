    int model;
};
// ---- Hair: Chiang et al. (2016) fibres, mirroring materials/hair_bsdf.h ----
// Local frame: x along the fibre, y and z across it. hairF returns the BSDF
// times its projected-area cosine, as directBSDF does for surfaces.
struct HairLobes {
    vec4 v;
    vec3 sin2k, cos2k;
    float s, gammaO;
};
vec3 hairAbsorption(vec3 c, float betaN) {
    float scale = 5.969 - .215 * betaN + 2.532 * betaN * betaN - 10.73 * pow(betaN, 3) +
                  5.574 * pow(betaN, 4) + .245 * pow(betaN, 5);
    vec3 l = log(clamp(c, 1e-4, 1)) / scale;
