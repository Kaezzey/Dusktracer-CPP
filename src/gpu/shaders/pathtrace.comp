            AreaLight light = areaLights[lo];
            Instance inst = instances[light.data.x];
            bool sphere = geometries[inst.data.x].w != 0;
            vec3 local = sphere ? uniformSphere() : vec3(0);
            float root = sqrt(random());
            vec2 bary = vec2(root * (1 - random()), 0);
            bary.y = root - bary.x;
            Hit lightHit = surfaceHit(light.data.x, light.data.y, local, bary, vec3(0, 0, 1));
            vec3 delta = lightHit.p - hit.p;
