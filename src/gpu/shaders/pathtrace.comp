// Unreal's Eye shading model (materials/eye.h: eye_shading::iris). Returns
// the base-colour UV seen through the cornea and sets the iris terms.
vec2 irisAt(Material m, Hit h, vec3 view, float maskPin, float depthPin, inout Surface s) {
    vec2 d = h.uv - m.iris.xy;
    float distance = length(d), radius = max(m.iris.z, 1e-6), r = distance / radius;
    float width = max(m.iris.w, 1e-6), x = clamp((radius + .5 * width - distance) / width, 0, 1);
    s.irisMask = maskPin >= 0 ? min(maskPin, 1) : x * x * (3 - 2 * x);
    float depth = depthPin >= 0 ? depthPin : max(0, m.eye.y) * max(0, 1 - r * r);
    vec3 local = vec3(dot(view, h.t), dot(view, h.b), dot(view, h.n));
    float eta = 1 / max(m.parameters.w, 1), c = max(local.z, 0);
    vec3 refracted = -eta * local + vec3(0, 0, eta * c - sqrt(max(0, 1 - eta * eta * (1 - c * c))));
    float travel = depth * radius / max(-refracted.z, .1);
    vec3 radial = distance > 1e-9 ? normalize(d.x * h.t + d.y * h.b) : vec3(0);
    float tilt = .5 * min(r, 1);
    s.irisN = normalize(sqrt(1 - tilt * tilt) * h.n - tilt * radial);
    float concave = min(.45, .5 * s.irisMask * min(depth, 1));
    s.causticN = safeNormal((1 - concave) * s.irisN - concave * h.n, s.irisN);
    return h.uv + s.irisMask * refracted.xy * travel;
}
