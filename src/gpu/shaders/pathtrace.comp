vec3 hairF(Surface s, HairLobes l, vec3 wo, vec3 wi, float ttScale) {
    float sinO = clamp(wo.x, -1, 1), cosO = sqrt(max(0, 1 - sinO * sinO));
    float sinI = clamp(wi.x, -1, 1), cosI = sqrt(max(0, 1 - sinI * sinI));
    float angle = atan(wi.z, wi.y) - atan(wo.z, wo.y), gammaT;
    vec3 ap[4];
    hairAttenuation(s, sinO, cosO, ap, gammaT);
    ap[1] *= ttScale;
    vec3 sum = vec3(0);
    for (int p = 0; p < 3; ++p) {
        vec2 o = hairTilt(p, sinO, cosO, l);
        sum += ap[p] * (hairMp(cosI, o.y, sinI, o.x, l.v[p]) * hairNp(angle, p, l.s, l.gammaO, gammaT));
    }
    sum += ap[3] * (hairMp(cosI, cosO, sinI, sinO, l.v[3]) / (2 * PI));
