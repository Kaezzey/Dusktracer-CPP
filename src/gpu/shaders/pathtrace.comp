    } else {
        angle = 2 * PI * random();
    }
    float phiI = phiO + angle;
    wi = vec3(sinI, cosI * cos(phiI), cosI * sin(phiI));
    pdf = hairPDF(s, l, wo, wi);
    if (!(pdf > 0)) return false;
    vec3 full = hairF(s, l, wo, wi, 1);
    weight = full / pdf;
