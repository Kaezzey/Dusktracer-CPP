        }
        Material material = materials[hit.material];
        Value base = baseRoot(material,hit.uv);
        float a = surfaceOpacity(hit,material,base);
        if (a <= 0 || (a < 1 && random() >= a)) {
            if (++nulls > 1024) {
                break;
            }
            origin = hit.p + direction * .001;
            --depth;
            continue;
        }
        Surface s = prepare(hit,base);
        vec3 view = -direction;
        if (depth == 0) {
            albedo = s.base;
            normal = hit.n;
        }
        if (s.model == MODEL_EMISSION) {
            vec3 emitted = (material.programs[0].y > 0 ? s.base : material.emission.rgb) * material.emission.w;
            vec3 contribution = prevIndirectOnly ? vec3(0) : throughput * emitted * hitWeight(prevPDF, emitterPDF(hit, previous, direction), count, prevDelta);
            result += contribution;
            if(indirectPath) indirect += contribution;
            break;
        }
        if (depth == cfg.image.w) {
            break;
        }
        vec3 caustic;
        vec3 direct=directLighting(hit,s,view,cfg.image.w-depth,caustic);
        result += throughput * (direct+caustic);
        if(indirectPath) indirect += throughput * direct;
        vec3 weight, next;
        float pdf;
        bool delta,subsurface,indirectOnly;
        if (!scatter(s, hit, view, next, weight, pdf, delta,subsurface,indirectOnly)) {
            break;
        }
        prevIndirectOnly = indirectOnly;
        if(subsurface) {
            Hit entry; vec3 spatialWeight;
            if(!sampleSubsurface(hit,s.base,entry,spatialWeight)) break;
            throughput *= weight*spatialWeight;
            hit=entry;
            s.model=MODEL_SUBSURFACE_ENTRY; s.n=entry.g; s.g=entry.g;
            direct=directLighting(entry,s,entry.g,cfg.image.w-depth,caustic);
            result += throughput*(direct+caustic);
            indirect += throughput*direct;
            indirectPath=true;
            next=frame(entry.g)*cosineHemisphere();
            float cosine=max(0,dot(entry.g,next));
            pdf=cosine/PI;
            weight=vec3(PI*entryTransmission(cosine,s.entryIOR)*s.entryNormalization);
            delta=false;
        }
        previous = hit.p;
        if(!delta) {
            lensOrigin=hit.p+.001*hit.g; lensDirection=normalize(next);
            lensPDF=dot(lensDirection,hit.g)>=0 && !indirectOnly?pdf:0; lensStage=0; lensInstance=-1;
        } else if(s.model==MODEL_GLASS && dot(next,hit.g)<0 && cfg.options.x!=0 && sunSamples>0 && lensPDF>0 && cfg.background.w>0) {
            if(lensStage==0 && hit.front) {
                vec3 center; float radius,eta;
                lensStage=-1;
                if(sphereLens(hit.instance,center,radius,eta)) {
                    vec3 offset=center-lensOrigin; float k=length(offset)/radius;
                    float theta=acos(clamp(dot(lensDirection,normalize(offset)),-1,1));
                    if(k>1 && theta<asin(1/k)*(1-1e-5)) {
                        lensDensity=lensMeasure(theta,k,eta); lensStage=1; lensInstance=hit.instance;
                    }
                }
            } else if(lensStage==1 && !hit.front && hit.instance==lensInstance) lensStage=2;
            else lensStage=-1;
        } else {lensStage=-1;lensPDF=0;}
        prevPDF = pdf;
        prevDelta = delta;
        indirectPath = indirectPath || !delta || (s.model==MODEL_METAL && material.f0.w>0);
        throughput *= weight;
        direction = normalize(next);
        origin = hit.p + .001*(s.model==MODEL_GLASS?direction:hit.g*(dot(direction, hit.g) >= 0 ? 1 : -1));
        if (depth >= 8) {
            float survival = clamp(max(throughput.x, max(throughput.y, throughput.z)), .05, .95);
            if (random() >= survival) {
                break;
            }
            throughput /= survival;
        }
    }
    indirect = max(vec3(0),finiteColour(indirect));
    return max(vec3(0), finiteColour(result));
}
vec3 reconstructed(uint index, uvec2 p) {
    Pixel center = pixels[index];
    vec3 value = max(finiteColour(center.sum.rgb / max(1,center.sum.w)),0);
    if((cfg.options.w & 8)==0) return value;
    vec3 indirect = max(finiteColour(center.indirect.rgb / max(1,center.sum.w)),0);
    float centerLum=luminance(indirect);
    if(centerLum<=.05) return value;
    float neighbours[24]; int count=0;
    for(int dy=-2;dy<=2;++dy) for(int dx=-2;dx<=2;++dx) {
        ivec2 q = ivec2(p)+ivec2(dx,dy);
        if((dx==0 && dy==0) || any(lessThan(q,ivec2(0))) || any(greaterThanEqual(q,cfg.image.xy))) continue;
        Pixel other = pixels[q.y*cfg.image.x+q.x];
        if(other.sum.w==0) continue; // partially rendered tiles are not black neighbours
        float y=luminance(max(finiteColour(other.indirect.rgb/max(1,other.sum.w)),0));
        int i=count;
        while(i>0 && neighbours[i-1]>y) { neighbours[i]=neighbours[i-1]; --i; }
        neighbours[i]=y; ++count;
    }
    if(count>=3) {
        float supported=neighbours[(count*3)/4];
        float ceiling=4*max(supported,4*neighbours[count/2])+.05;
        if(centerLum>ceiling) value=max(vec3(0),value-indirect*(1-supported/centerLum));
    }
    return value;
}
float halton(uint index, uint base) {
    float sum = 0, f = 1;
    while (index > 0) {
        f /= base;
        sum += f * (index % base);
        index /= base;
    }
    return sum;
}
float pixelHash(uint x, uint y) {
    uint n = x * 73856093u ^ y * 19349663u;
    n = (n << 13) ^ n;
    return float((n * (n * n * 15731u + 789221u) + 1376312589u) & 0x7fffffffu) / 2147483647.0;
}
void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy + uvec2(dispatch.offsetX, dispatch.offsetY);
    if(dispatch.sampleCount>0 && dispatch.offsetY==0xffffffffu) {
        uint columns=(uint(cfg.image.x)+255u)/256u;
        uint tile=dispatch.offsetX+gl_WorkGroupID.z;
        pixel=gl_GlobalInvocationID.xy+256u*uvec2(tile%columns,tile/columns);
    }
    if (any(greaterThanEqual(pixel, uvec2(cfg.image.xy)))) {
        return;
    }
    uint index = pixel.y * uint(cfg.image.x) + pixel.x;
    Pixel accum = pixels[index];
    if (dispatch.sampleCount == 0) {
        vec3 linear = reconstructed(index,pixel) * uintBitsToFloat(dispatch.sampleIndex);
        float lum = luminance(linear);
        vec3 mapped = linear * (lum < 1e-6 ? 0 : 1 / (1 + lum));
        vec3 encoded = mix(1.055 * pow(max(mapped,0), vec3(1.0/2.4)) - .055,
                           mapped * 12.92, lessThanEqual(mapped, vec3(.0031308)));
        uvec3 rgb = uvec3(256 * clamp(encoded, 0, .999));
        displayPixels[index] = rgb.r | (rgb.g << 8) | (rgb.b << 16) | 0xff000000u;
        return;
    }
    if (accum.variance.z != 0) {
        return;
    }
    for (uint offset = 0; offset < dispatch.sampleCount; ++offset) {
        if (accum.variance.z != 0) {
            break;
        }
        uint sampleIndex = dispatch.sampleIndex + offset;
        rng = hash(index ^ hash(sampleIndex + 0x243f6a88u));
        vec2 jitter = cfg.options.y == 1
                          ? fract(vec2(halton(sampleIndex + 1, 2), halton(sampleIndex + 1, 3)) +
                                  vec2(pixelHash(pixel.x, pixel.y), pixelHash(pixel.y, pixel.x))) -
                                .5
                          : vec2(random(), random()) - .5;
        vec3 origin = cfg.origin.xyz;
        if (cfg.origin.w > 0) {
            float r = sqrt(random()), p = 2 * PI * random();
            origin += r * (cos(p) * cfg.defocusU.xyz + sin(p) * cfg.defocusV.xyz);
        }
        vec3 direction = normalize(cfg.pixel00.xyz + (pixel.x + jitter.x) * cfg.deltaU.xyz +
                                   (pixel.y + jitter.y) * cfg.deltaV.xyz - origin);
        vec3 albedo, normal, indirect;
        vec3 value = pathTrace(origin, direction, albedo, normal, indirect);
        accum.sum += vec4(value, 1);
        accum.indirect += vec4(indirect,0);
        accum.albedo += vec4(albedo, 0);
        accum.normal += vec4(normal, 0);
        float y = luminance(value), delta = y - accum.variance.x;
        accum.variance.x += delta / accum.sum.w;
        accum.variance.y += delta * (y - accum.variance.x);
        if (cfg.options.z != 0 && accum.sum.w >= cfg.adaptive.x &&
            int(accum.sum.w) % max(1, int(cfg.adaptive.y)) == 0) {
            float error = sqrt(max(0, accum.variance.y / (accum.sum.w - 1) / accum.sum.w));
            // A single quiet batch is not evidence that a rare caustic has converged.
            bool quiet = error < max(cfg.adaptive.w, cfg.adaptive.z * abs(accum.variance.x));
            accum.variance.w = quiet ? accum.variance.w+1 : 0;
            if (accum.variance.w >= 2) {
                accum.variance.z = 1;
                atomicAdd(convergedCount, 1);
            }
        }
    }
    pixels[index] = accum;
}
