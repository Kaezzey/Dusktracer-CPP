        etaI = eta;
        etaT = 1;
        cosI = -cosI;
    }
    float sinT = etaI / etaT * sqrt(max(0, 1 - cosI * cosI));
    if (sinT >= 1) return 1;
    float cosT = sqrt(max(0, 1 - sinT * sinT));
    float parallel = (etaT * cosI - etaI * cosT) / (etaT * cosI + etaI * cosT);
    float perpendicular = (etaI * cosI - etaT * cosT) / (etaI * cosI + etaT * cosT);
    return .5 * (parallel * parallel + perpendicular * perpendicular);
}
float hairLogisticCDF(float x, float s) { return 1 / (1 + exp(-x / s)); }
float hairNp(float angle, int p, float s, float gammaO, float gammaT) {
    float d = angle - (2 * p * gammaT - 2 * gammaO + p * PI);
    d -= 2 * PI * roundEven(d / (2 * PI));
    float e = exp(-abs(d) / s);
    return e / (s * (1 + e) * (1 + e)) / (hairLogisticCDF(PI, s) - hairLogisticCDF(-PI, s));
}
HairLobes hairLobes(Surface s) {
    float betaM = clamp(s.hairShape.y, .02, 1), betaN = clamp(s.hairShape.z, .02, 1);
    HairLobes l;
    float root = .726 * betaM + .812 * betaM * betaM + 3.7 * pow(betaM, 20);
    l.v = vec4(1, .25, 4, 4) * (root * root);
    l.s = sqrt(PI / 8) * (.265 * betaN + 1.194 * betaN * betaN + 5.372 * pow(betaN, 22));
    l.sin2k.x = sin(radians(s.hairShape.w));
    l.cos2k.x = sqrt(max(0, 1 - l.sin2k.x * l.sin2k.x));
    for (int i = 1; i < 3; ++i) {
        l.sin2k[i] = 2 * l.cos2k[i - 1] * l.sin2k[i - 1];
        l.cos2k[i] = l.cos2k[i - 1] * l.cos2k[i - 1] - l.sin2k[i - 1] * l.sin2k[i - 1];
    }
