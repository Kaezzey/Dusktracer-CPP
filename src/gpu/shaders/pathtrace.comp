        uint sampleIndex = dispatch.sampleIndex + offset;
        rng = hash(index ^ hash(sampleIndex + 0x243f6a88u));
        vec2 jitter = cfg.options.y == 1
                          ? fract(vec2(halton(sampleIndex + 1, 2), halton(sampleIndex + 1, 3)) +
                                  vec2(pixelHash(pixel.x, pixel.y), pixelHash(pixel.y, pixel.x))) -
                                .5
