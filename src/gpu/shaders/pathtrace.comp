}
vec3 lightContribution(Hit hit, Surface s, vec3 view, vec3 direction, vec3 radiance, float maxT, float weight,
                       float mis) {
    vec3 bsdf = directBSDF(s, view, direction);
    if (all(equal(bsdf, vec3(0)))) {
        return vec3(0);
    }
    vec3 origin = hit.p + hit.g * (dot(direction, hit.g) >= 0 ? .001 : -.001);
    return bsdf * radiance * (weight * mis * visibility(origin, direction, maxT));
}
vec3 pathTrace(vec3 origin, vec3 direction, out vec3 albedo, out vec3 normal) {
    vec3 result = vec3(0), throughput = vec3(1), previous = origin;
    float prevPDF = 0;
    bool prevDelta = true;
    albedo = vec3(0);
    normal = vec3(0);
    int nulls = 0, count = max(0, cfg.counts.z), sunSamples = count > 0 ? max(1, cfg.counts.w) : 0;
    for (int depth = 0; depth <= cfg.image.w; ++depth) {
        Hit hit;
        if (!trace(origin, direction, 1e30, hit)) {
            result += throughput * cfg.background.rgb;
            float pdf = sunPDF(direction);
            if (pdf > 0) {
                result +=
                    throughput * cfg.sunRadiance.rgb * pdf * hitWeight(prevPDF, pdf, sunSamples, prevDelta);
            }
            break;
        }
        float a = opacity(hit);
        if (a <= 0 || (a < 1 && random() >= a)) {
            if (++nulls > 1024) {
                break;
            }
            origin = hit.p + direction * .001;
            --depth;
            continue;
        }
        Surface s = prepare(hit);
        vec3 view = -direction;
        if (depth == 0) {
            albedo = s.base;
            normal = hit.n;
        }
        if (s.model == MODEL_EMISSION) {
            result += throughput * emission(hit) *
                      hitWeight(prevPDF, emitterPDF(hit, previous, direction), count, prevDelta);
            break;
        }
        if (depth == cfg.image.w) {
            break;
        }
        vec3 direct = vec3(0);
        if (cfg.sunRadiance.w != 0) {
            float omega = cfg.sunDirection.w;
            int samples = omega <= 1e-12 ? 1 : sunSamples;
            mat3 basis = frame(cfg.sunDirection.xyz);
            for (int j = 0; j < samples; ++j) {
                vec3 l = cfg.sunDirection.xyz;
                float mis = 1;
                if (omega > 1e-12) {
                    float z = 1 - random() * omega / (2 * PI), phi = 2 * PI * random(),
                          r = sqrt(max(0, 1 - z * z));
                    l = basis * vec3(r * cos(phi), r * sin(phi), z);
                    if (cfg.options.x != 0) {
                        mis = powerWeight(samples / omega, bsdfPDF(s, view, l));
                    }
                }
                direct += lightContribution(hit, s, view, l, cfg.sunRadiance.rgb, 1e30, 1.0 / samples, mis);
            }
        }
        // Sample point lights uniformly. Every positive light has support; the
        // inverse selection probability keeps the result independent of count.
        int pointSamples = max(1, count);
        for (int j = 0; j < pointSamples && cfg.counts.x > 0; ++j) {
            int index = min(int(random() * cfg.counts.x), cfg.counts.x - 1);
            PointLight light = pointLights[index];
            vec3 delta = light.position.xyz - hit.p;
            float distance = length(delta);
            if (distance <= .002 || (light.position.w > 0 && distance > light.position.w)) {
                continue;
            }
            direct +=
                lightContribution(hit, s, view, delta / distance, light.radiance.rgb / (distance * distance),
                                  distance - .002, float(cfg.counts.x) / pointSamples, 1);
        }
        for (int j = 0; j < count && cfg.counts.y > 0; ++j) {
            float u = random();
            int lo = 0, hi = cfg.counts.y - 1;
            while (lo < hi) {
                int mid = (lo + hi) / 2;
                if (areaLights[mid].distribution.x < u) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            AreaLight light = areaLights[lo];
            Instance inst = instances[light.data.x];
            bool sphere = geometries[inst.data.x].w != 0;
            vec3 local = sphere ? uniformSphere() : vec3(0);
            float root = sqrt(random());
            vec2 bary = vec2(root * (1 - random()), 0);
            bary.y = root - bary.x;
            Hit lightHit = surfaceHit(light.data.x, light.data.y, local, bary, vec3(0, 0, 1));
            vec3 delta = lightHit.p - hit.p;
            float distance = length(delta);
            if (distance <= .002) {
                continue;
            }
            vec3 l = delta / distance;
            float cosine = abs(dot(lightHit.g, -l));
            if (cosine <= 1e-12) {
                continue;
            }
            float pdf = light.distribution.y * distance * distance / (emitterSampleArea(light,lightHit) * cosine);
            float mis = cfg.options.x != 0 ? powerWeight(count * pdf, bsdfPDF(s, view, l)) : 1;
            direct += lightContribution(hit, s, view, l, emission(lightHit), distance - .002,
                                        1 / (count * pdf), mis);
        }
        result += throughput * direct;
        vec3 weight, next;
        float pdf;
        bool delta;
        if (!scatter(s, hit, view, next, weight, pdf, delta)) {
            break;
        }
        previous = hit.p;
        prevPDF = pdf;
        prevDelta = delta;
        throughput *= weight;
        direction = normalize(next);
        origin = hit.p + hit.g * (dot(direction, hit.g) >= 0 ? .001 : -.001);
        if (depth >= 8) {
            float survival = clamp(max(throughput.x, max(throughput.y, throughput.z)), .05, .95);
            if (random() >= survival) {
                break;
            }
            throughput /= survival;
        }
    }
    return max(vec3(0), finiteColour(result));
}
float halton(uint index, uint base) {
    float sum = 0, f = 1;
    while (index > 0) {
        f /= base;
        sum += f * (index % base);
        index /= base;
    }
    return sum;
}
float pixelHash(uint x, uint y) {
    uint n = x * 73856093u ^ y * 19349663u;
    n = (n << 13) ^ n;
    return float((n * (n * n * 15731u + 789221u) + 1376312589u) & 0x7fffffffu) / 2147483647.0;
}
void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy + uvec2(dispatch.offsetX, dispatch.offsetY);
    if (any(greaterThanEqual(pixel, uvec2(cfg.image.xy)))) {
        return;
    }
    uint index = pixel.y * uint(cfg.image.x) + pixel.x;
    Pixel accum = pixels[index];
    if (accum.variance.z != 0) {
        return;
    }
    for (uint offset = 0; offset < dispatch.sampleCount; ++offset) {
        if (accum.variance.z != 0) {
            break;
        }
        uint sampleIndex = dispatch.sampleIndex + offset;
        rng = hash(index ^ hash(sampleIndex + 0x243f6a88u));
        vec2 jitter = cfg.options.y == 1
                          ? fract(vec2(halton(sampleIndex + 1, 2), halton(sampleIndex + 1, 3)) +
                                  vec2(pixelHash(pixel.x, pixel.y), pixelHash(pixel.y, pixel.x))) -
                                .5
                          : vec2(random(), random()) - .5;
        vec3 origin = cfg.origin.xyz;
        if (cfg.origin.w > 0) {
            float r = sqrt(random()), p = 2 * PI * random();
            origin += r * (cos(p) * cfg.defocusU.xyz + sin(p) * cfg.defocusV.xyz);
        }
        vec3 direction = normalize(cfg.pixel00.xyz + (pixel.x + jitter.x) * cfg.deltaU.xyz +
                                   (pixel.y + jitter.y) * cfg.deltaV.xyz - origin);
        vec3 albedo, normal;
        vec3 value = pathTrace(origin, direction, albedo, normal);
        accum.sum += vec4(value, 1);
        accum.albedo += vec4(albedo, 0);
        accum.normal += vec4(normal, 0);
        float y = luminance(value), delta = y - accum.variance.x;
        accum.variance.x += delta / accum.sum.w;
        accum.variance.y += delta * (y - accum.variance.x);
        if (cfg.options.z != 0 && accum.sum.w >= cfg.adaptive.x &&
            int(accum.sum.w) % max(1, int(cfg.adaptive.y)) == 0) {
            float error = sqrt(max(0, accum.variance.y / (accum.sum.w - 1) / accum.sum.w));
            if (error < max(cfg.adaptive.w, cfg.adaptive.z * abs(accum.variance.x))) {
                accum.variance.z = 1;
                atomicAdd(convergedCount, 1);
            }
        }
    }
    pixels[index] = accum;
}
