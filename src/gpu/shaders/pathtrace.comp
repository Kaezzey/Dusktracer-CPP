vec3 reconstructed(uint index, uvec2 p) {
    Pixel center = pixels[index];
    vec3 value = max(finiteColour(center.sum.rgb / max(1,center.sum.w)),0);
    if((cfg.options.w & 8)==0) return value;
    vec3 indirect = max(finiteColour(center.indirect.rgb / max(1,center.sum.w)),0);
    float centerLum=luminance(indirect);
    if(centerLum<=.05) return value;
    float neighbours[24]; int count=0;
    for(int dy=-2;dy<=2;++dy) for(int dx=-2;dx<=2;++dx) {
        ivec2 q = ivec2(p)+ivec2(dx,dy);
        if((dx==0 && dy==0) || any(lessThan(q,ivec2(0))) || any(greaterThanEqual(q,cfg.image.xy))) continue;
        Pixel other = pixels[q.y*cfg.image.x+q.x];
        if(other.sum.w==0) continue; // partially rendered tiles are not black neighbours
        float y=luminance(max(finiteColour(other.indirect.rgb/max(1,other.sum.w)),0));
        int i=count;
        while(i>0 && neighbours[i-1]>y) { neighbours[i]=neighbours[i-1]; --i; }
        neighbours[i]=y; ++count;
    }
    if(count>=3) {
        float supported=neighbours[(count*3)/4];
        float ceiling=4*max(supported,4*neighbours[count/2])+.05;
        if(centerLum>ceiling) value=max(vec3(0),value-indirect*(1-supported/centerLum));
    }
    return value;
}
float halton(uint index, uint base) {
    float sum = 0, f = 1;
    while (index > 0) {
        f /= base;
        sum += f * (index % base);
        index /= base;
    }
    return sum;
}
float pixelHash(uint x, uint y) {
    uint n = x * 73856093u ^ y * 19349663u;
    n = (n << 13) ^ n;
    return float((n * (n * n * 15731u + 789221u) + 1376312589u) & 0x7fffffffu) / 2147483647.0;
}
void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy + uvec2(dispatch.offsetX, dispatch.offsetY);
    if(dispatch.sampleCount>0 && dispatch.offsetY==0xffffffffu) {
        uint columns=(uint(cfg.image.x)+255u)/256u;
        uint tile=dispatch.offsetX+gl_WorkGroupID.z;
        pixel=gl_GlobalInvocationID.xy+256u*uvec2(tile%columns,tile/columns);
    }
    if (any(greaterThanEqual(pixel, uvec2(cfg.image.xy)))) {
        return;
    }
    uint index = pixel.y * uint(cfg.image.x) + pixel.x;
    Pixel accum = pixels[index];
    if (dispatch.sampleCount == 0) {
        vec3 linear = reconstructed(index,pixel) * uintBitsToFloat(dispatch.sampleIndex);
        float lum = luminance(linear);
        vec3 mapped = linear * (lum < 1e-6 ? 0 : 1 / (1 + lum));
        vec3 encoded = mix(1.055 * pow(max(mapped,0), vec3(1.0/2.4)) - .055,
                           mapped * 12.92, lessThanEqual(mapped, vec3(.0031308)));
        uvec3 rgb = uvec3(256 * clamp(encoded, 0, .999));
