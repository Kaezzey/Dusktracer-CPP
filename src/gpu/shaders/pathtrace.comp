#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;
const float PI = 3.14159265358979323846;
// Keep these values aligned with graph_kind and scene_material_model.
const int NODE_CONSTANT = -1;
const int NODE_OUTPUT = 0;
const int NODE_TEXTURE = 1;
const int NODE_SCALAR = 2;
const int NODE_VECTOR = 3;
const int NODE_TEXCOORD = 4;
const int NODE_ADD = 5;
const int NODE_SUBTRACT = 6;
const int NODE_MULTIPLY = 7;
const int NODE_DIVIDE = 8;
const int NODE_LERP = 9;
const int NODE_ONE_MINUS = 10;
const int NODE_SATURATE = 11;
const int NODE_POWER = 12;
const int NODE_REROUTE = 13;
const int NODE_COMBINE = 14;
const int NODE_DERIVE_NORMAL_Z = 15;
const int MODEL_LAMBERT = 0;
const int MODEL_METAL = 1;
const int MODEL_GLASS = 2;
const int MODEL_EMISSION = 3;
const int MODEL_ISOTROPIC = 4;
const int MODEL_PBR = 5;
const int MODEL_HAIR = 6;
const int MODEL_EYE = 7;
const int ALPHA_CLIP = 1;
// Internal: a diffusion entry point, never a scene material model.
const int MODEL_SUBSURFACE_ENTRY = 64;

struct Vertex {
    vec4 position, normal, tangent, bitangent, uv;
};
struct Instance {
    vec4 rows[3];
    ivec4 data;
};
struct Material {
    vec4 base, parameters, f0, emission, alpha, subsurface, scatterTint, subsurfaceDistances;
    vec4 subsurfaceColour, specularLobes, profileTint;
    vec4 hair, hairTangent;
    vec4 iris, eye; // Eye: centre U, V, UV radius, limbus width; Specular, iris depth
    ivec4 programs[7];
};
struct Instruction {
    ivec4 code, inputs, channels;
    vec4 value, defaults;
};
struct AreaLight {
    ivec4 data;
    vec4 distribution;
};
struct Pixel {
    vec4 sum, albedo, normal, variance, indirect;
};
struct PointLight {
    vec4 position, radiance;
};
layout(binding = 0) uniform accelerationStructureEXT world;
layout(std430, binding = 1) readonly buffer Geometries {
    ivec4 geometries[];
};
layout(std430, binding = 2) readonly buffer Vertices {
    Vertex vertices[];
};
layout(std430, binding = 3) readonly buffer Instances {
    Instance instances[];
};
layout(std430, binding = 4) readonly buffer MaterialMaps {
    uint materialMaps[];
};
layout(std430, binding = 5) readonly buffer Materials {
    Material materials[];
};
layout(std430, binding = 6) readonly buffer Instructions {
    Instruction instructions[];
};
layout(std430, binding = 7) readonly buffer Textures {
    ivec4 textures[];
};
layout(std430, binding = 8) readonly buffer Texels {
    uint texels[];
};
layout(std430, binding = 9) buffer Pixels {
    uint convergedCount; // Pixel array begins at its 16-byte alignment.
    Pixel pixels[];
};
layout(std430, binding = 10) readonly buffer Configuration {
    vec4 origin, pixel00, deltaU, deltaV, defocusU, defocusV;
    vec4 background, sunDirection, sunRadiance, adaptive;
    ivec4 image, counts, options;
}
cfg;
layout(std430, binding = 11) readonly buffer Points {
    PointLight pointLights[];
};
layout(std430, binding = 12) readonly buffer Areas {
    AreaLight areaLights[];
};
layout(std430, binding = 13) readonly buffer Slots {
    uint slots[];
};
layout(std430, binding = 14) writeonly buffer DisplayPixels {
    uint displayPixels[];
};
layout(push_constant) uniform Dispatch {
    uint sampleIndex, offsetX, offsetY, sampleCount;
}
dispatch;

uint rng;
uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    return x ^ (x >> 16);
}
float random() {
    rng = hash(rng + 0x9e3779b9u);
    return float(rng >> 8) * (1.0 / 16777216.0);
}
vec3 safeNormal(vec3 v, vec3 fallback) {
    float l = dot(v, v);
    return l > 1e-20 && !isinf(l) && !isnan(l) ? v * inversesqrt(l) : fallback;
}
mat3 frame(vec3 n) {
    vec3 t = normalize(cross(abs(n.z) < .999 ? vec3(0, 0, 1) : vec3(0, 1, 0), n));
    return mat3(t, cross(n, t), n);
}
vec3 uniformSphere() {
    float z = 1 - 2 * random(), p = 2 * PI * random(), r = sqrt(max(0, 1 - z * z));
    return vec3(r * cos(p), r * sin(p), z);
}
vec3 cosineHemisphere() {
    float r = sqrt(random()), p = 2 * PI * random();
    return vec3(r * cos(p), r * sin(p), sqrt(max(0, 1 - r * r)));
}
float luminance(vec3 c) {
    return dot(c, vec3(.2126, .7152, .0722));
}
vec3 finiteColour(vec3 c) {
    for (int k = 0; k < 3; ++k) {
        if (isnan(c[k]) || isinf(c[k])) {
            c[k] = 0;
        }
    }
    return c;
}
vec3 srgb(vec3 c) {
    c = clamp(c, 0, 1);
    return mix(pow((c + .055) / 1.055, vec3(2.4)), c / 12.92, lessThanEqual(c, vec3(.04045)));
}

// Two registers preserve both color-space RGB and raw channel values, plus
// independent alpha and explicit-mask outputs, exactly as the CPU graph does.
struct Value {
    vec4 colour, raw;
};
Value scalarValue(float x) {
    return Value(vec4(vec3(x), 1), vec4(vec3(x), x));
}
// X and Y in [0, 1] encode [-1, 1]; Z completes a unit vector, re-encoded to
// [0, 1] like a normal-map texel (material_graph.cpp: derived_normal).
vec3 derivedNormal(float x, float y) {
    float nx = 2 * x - 1, ny = 2 * y - 1;
    return vec3(x, y, .5 * (sqrt(max(0, 1 - nx * nx - ny * ny)) + 1));
}
Value channelValue(Value v, int c) {
    if (c == 0) {
        return v;
    }
    return scalarValue(c <= 3 ? v.raw[c - 1] : c == 4 ? v.colour.a : v.raw.a);
}
Value texelValue(ivec4 info, ivec2 p, int flags) {
    int ch = info.w & 255;
    bool hdr = (info.w & 256) != 0;
    uint index = uint(info.x + (p.y * info.y + p.x) * (hdr ? 4 : 1));
    vec4 texel;
    if (hdr) {
        texel =
            uintBitsToFloat(uvec4(texels[index], texels[index + 1], texels[index + 2], texels[index + 3]));
    } else {
        texel = unpackUnorm4x8(texels[index]);
    }
    float alpha = clamp(ch == 1 ? texel.r : (ch == 2 || ch == 4) ? texel.a : 1, 0, 1);
    float mask = clamp(ch == 3 ? luminance(texel.rgb) : alpha, 0, 1);
    vec3 color = ((flags & 1) != 0 && !hdr) ? srgb(texel.rgb) : texel.rgb;
    vec3 raw = (flags & 2) != 0 ? color : texel.rgb;
    return Value(vec4(color, alpha), vec4(raw, mask));
}
// Bilinear between texel centres, clamped to the edge texels, as on the CPU
// (image_texture::filter). Texels are decoded before blending.
Value textureValue(int id, vec2 uv, int flags) {
    if (id < 0) {
        return Value(vec4(1, 0, 1, 1), vec4(1, 0, 1, 1));
    }
    ivec4 info = textures[id];
    vec2 x = clamp(vec2(uv.x, 1 - uv.y), 0, 1) * vec2(info.yz) - .5;
    ivec2 p0 = ivec2(floor(x));
    vec2 f = x - vec2(p0);
    ivec2 p1 = clamp(p0 + 1, ivec2(0), info.yz - 1);
    p0 = clamp(p0, ivec2(0), info.yz - 1);
    Value a = texelValue(info, p0, flags), b = texelValue(info, ivec2(p1.x, p0.y), flags);
    Value c = texelValue(info, ivec2(p0.x, p1.y), flags), d = texelValue(info, p1, flags);
    return Value(mix(mix(a.colour, b.colour, f.x), mix(c.colour, d.colour, f.x), f.y),
                 mix(mix(a.raw, b.raw, f.x), mix(c.raw, d.raw, f.x), f.y));
}
Value evaluateRoot(ivec4 program, vec2 uv) {
    Value registers[32];
    for (int pc = 0; pc < program.y; ++pc) {
        Instruction op = instructions[program.x + pc];
        Value a = op.inputs.x < 0 ? scalarValue(op.defaults.x)
                                  : channelValue(registers[op.inputs.x], op.channels.x);
        Value b = op.inputs.y < 0 ? scalarValue(op.defaults.y)
                                  : channelValue(registers[op.inputs.y], op.channels.y);
        Value c = op.inputs.z < 0 ? scalarValue(op.defaults.z)
                                  : channelValue(registers[op.inputs.z], op.channels.z);
        Value result = scalarValue(0);
        // One flat switch: a long else-if chain here, inlined at every call,
        // nests deeply enough to crash glslc's optimiser.
        vec3 av = a.colour.rgb, bv = b.colour.rgb, t = c.colour.rgb, r = av;
        float alpha = a.colour.a;
        int kind = op.code.x;
        switch (kind) {
        case NODE_CONSTANT:
            result = Value(op.value, op.defaults);
            break;
        case NODE_TEXTURE:
            result = textureValue(op.code.z, op.inputs.x < 0 ? uv : fract(a.colour.xy), op.code.w);
            break;
        case NODE_SCALAR: r = vec3(op.value.x); alpha = 1; break;
        case NODE_VECTOR: r = op.value.xyz; alpha = 1; break;
        case NODE_TEXCOORD: r = vec3(uv * op.value.xy, 0); alpha = 1; break;
        case NODE_COMBINE: r = vec3(a.colour.r, b.colour.r, c.colour.r); alpha = 1; break;
        case NODE_DERIVE_NORMAL_Z: r = derivedNormal(a.colour.r, b.colour.r); alpha = 1; break;
        case NODE_ADD: r = av + bv; break;
        case NODE_SUBTRACT: r = av - bv; break;
        case NODE_MULTIPLY: r = av * bv; alpha *= b.colour.a; break;
        case NODE_DIVIDE:
            for (int k = 0; k < 3; ++k) {
                r[k] = abs(bv[k]) < 1e-8 ? 0 : av[k] / bv[k];
            }
            break;
        case NODE_LERP: r = mix(av, bv, t); alpha = mix(a.colour.a, b.colour.a, c.colour.r); break;
        case NODE_ONE_MINUS: r = 1 - av; break;
        case NODE_SATURATE: r = clamp(av, 0, 1); break;
        case NODE_POWER:
            for (int k = 0; k < 3; ++k) {
                r[k] = bv[k] == 0 ? 1 : pow(max(0, av[k]), bv[k]);
            }
            break;
        default: break; // Reroute passes A through.
        }
        if (kind != NODE_CONSTANT && kind != NODE_TEXTURE) {
            result.colour = vec4(finiteColour(r), alpha);
            result.raw = vec4(result.colour.rgb, result.colour.r);
        }
        registers[op.code.y] = result;
    }
    return registers[program.z];
}
Value evaluate(ivec4 program, vec2 uv) { return channelValue(evaluateRoot(program,uv),program.w); }
bool sameProgram(ivec4 a, ivec4 b) { return a.y > 0 && all(equal(a.xyz,b.xyz)); }
Value baseRoot(Material m, vec2 uv) {
    return m.programs[0].y > 0 ? evaluateRoot(m.programs[0],uv) : Value(vec4(m.base.rgb,1),vec4(m.base.rgb,1));
}

vec3 transformVector(Instance inst, vec3 p) {
    return vec3(dot(inst.rows[0].xyz, p), dot(inst.rows[1].xyz, p), dot(inst.rows[2].xyz, p));
}
vec3 transformPoint(Instance inst, vec3 p) {
    return transformVector(inst, p) + vec3(inst.rows[0].w, inst.rows[1].w, inst.rows[2].w);
}
mat3 instanceMatrix(Instance inst) {
    return transpose(mat3(inst.rows[0].xyz, inst.rows[1].xyz, inst.rows[2].xyz));
}
struct Hit {
    vec3 p, n, g, t, b;
    // Outward offset to the smooth surface of the vertex normals (Hanika
    // 2021); see hit_record::smooth_offset.
    vec3 so;
    vec2 uv;
    float distance;
    int material, instance, primitive;
    bool front;
};
Hit surfaceHit(int instanceId, int primitiveId, vec3 localPosition, vec2 bary, vec3 rayDirection) {
    Hit h;
    Instance inst = instances[instanceId];
    ivec4 geom = geometries[inst.data.x];
    vec3 ng, ns, t, b, p, so = vec3(0);
    vec2 uv;
    if (geom.w != 0) {
        p = localPosition;
        ng = safeNormal(p, vec3(0, 1, 0));
        ns = ng;
        uv = vec2((atan(-ng.z, ng.x) + PI) / (2 * PI), acos(clamp(-ng.y, -1, 1)) / PI);
        // The CPU's sphere frame flips its increasing-u tangent on back faces.
        vec3 faced = dot(transformVector(inst, ng), rayDirection) < 0 ? ng : -ng;
        t = safeNormal(
            vec3(faced.z, 0, -faced.x),
            safeNormal(cross(abs(faced.y) < .999 ? vec3(0, 1, 0) : vec3(1, 0, 0), faced), vec3(1, 0, 0)));
        b = cross(faced, t);
        h.material = int(materialMaps[inst.data.y]);
    } else {
        int start = geom.x + primitiveId * 3;
        Vertex a = vertices[start], v = vertices[start + 1], c = vertices[start + 2];
        vec3 w = vec3(1 - bary.x - bary.y, bary.x, bary.y);
        p = a.position.xyz * w.x + v.position.xyz * w.y + c.position.xyz * w.z;
        ng = safeNormal(cross(v.position.xyz - a.position.xyz, c.position.xyz - a.position.xyz),
                        vec3(0, 1, 0));
        ns = safeNormal(a.normal.xyz * w.x + v.normal.xyz * w.y + c.normal.xyz * w.z, ng);
        t = a.tangent.xyz * w.x + v.tangent.xyz * w.y + c.tangent.xyz * w.z;
        b = a.bitangent.xyz * w.x + v.bitangent.xyz * w.y + c.bitangent.xyz * w.z;
        uv = a.uv.xy * w.x + v.uv.xy * w.y + c.uv.xy * w.z;
        // Lift p onto each vertex's tangent plane where it lies below it, then
        // blend barycentrically (triangle.h: smooth_surface_offset).
        vec3 la = p - min(0, dot(p - a.position.xyz, a.normal.xyz)) * a.normal.xyz;
        vec3 lb = p - min(0, dot(p - v.position.xyz, v.normal.xyz)) * v.normal.xyz;
        vec3 lc = p - min(0, dot(p - c.position.xyz, c.normal.xyz)) * c.normal.xyz;
        so = la * w.x + lb * w.y + lc * w.z - p;
        h.material = int(materialMaps[inst.data.y + int(slots[geom.y + primitiveId])]);
    }
    mat3 normalMatrix = transpose(inverse(instanceMatrix(inst)));
    vec3 worldGeometry = normalize(normalMatrix * ng);
    h.front = dot(rayDirection, worldGeometry) < 0;
    vec3 localNormal = h.front ? ns : -ns;
    vec3 localGeometry = h.front ? ng : -ng;
    if (dot(localNormal, localGeometry) < 0) {
        localNormal = -localNormal;
    }
    // Match the CPU's two-stage frame construction. Orthogonalizing only after
    // a nonuniform instance transform changes the direction of skewed tangents.
    vec3 localTangent = safeNormal(t - dot(t, localNormal) * localNormal, frame(localNormal)[0]);
    vec3 localBitangent = cross(localNormal, localTangent);
    if (dot(localBitangent, b) < 0) {
        localBitangent = -localBitangent;
    }
    h.g = h.front ? worldGeometry : -worldGeometry;
    h.n = safeNormal(normalMatrix * localNormal, h.g);
    if (dot(h.n, h.g) < 0) {
        h.n = -h.n;
    }
    t = transformVector(inst, localTangent);
    b = transformVector(inst, localBitangent);
    h.t = safeNormal(t - dot(t, h.n) * h.n, frame(h.n)[0]);
    h.b = cross(h.n, h.t);
    if (dot(h.b, b) < 0) {
        h.b = -h.b;
    }
    h.p = transformPoint(inst, p);
    h.so = transformVector(inst, so);
    h.uv = uv;
    h.instance = instanceId;
    h.primitive = primitiveId;
    h.distance = 0;
    return h;
}
float sphereIntersection(vec3 o, vec3 d, float minT, float maxT) {
    float a = dot(d,d), b = dot(o,d), discriminant = b*b - a*(dot(o,o)-1);
    if (discriminant >= 0) {
        float t = (-b-sqrt(discriminant))/a;
        if (t <= minT) t = (-b+sqrt(discriminant))/a;
        if (t > minT && t < maxT) return t;
    }
    return -1;
}
bool traceRangeMasked(vec3 origin, vec3 direction, float minT, float maxT, uint mask, out Hit hit) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, world, gl_RayFlagsOpaqueEXT, mask, origin, minT, direction, maxT);
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            float t = sphereIntersection(rayQueryGetIntersectionObjectRayOriginEXT(query,false),
                                          rayQueryGetIntersectionObjectRayDirectionEXT(query,false),minT,maxT);
            if (t > 0) rayQueryGenerateIntersectionEXT(query,t);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return false;
    }
    int id = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
    int primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
    float t = rayQueryGetIntersectionTEXT(query, true);
    vec3 p = rayQueryGetIntersectionObjectRayOriginEXT(query, true) +
             t * rayQueryGetIntersectionObjectRayDirectionEXT(query, true);
    vec2 bary = geometries[instances[id].data.x].w != 0 ? vec2(0)
                                                        : rayQueryGetIntersectionBarycentricsEXT(query, true);
    hit = surfaceHit(id, primitive, p, bary, direction);
    hit.p = origin + t * direction;
    hit.distance = t;
    return true;
}
bool traceRange(vec3 origin, vec3 direction, float minT, float maxT, out Hit hit) {
    return traceRangeMasked(origin,direction,minT,maxT,255u,hit);
}
bool blockedByOpaque(vec3 origin, vec3 direction, float maxT) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, world, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                          1u, origin, .001, direction, maxT);
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query,false) == gl_RayQueryCandidateIntersectionAABBEXT) {
            float t = sphereIntersection(rayQueryGetIntersectionObjectRayOriginEXT(query,false),
                                          rayQueryGetIntersectionObjectRayDirectionEXT(query,false),.001,maxT);
            if (t > 0) rayQueryGenerateIntersectionEXT(query,t);
        }
    }
    return rayQueryGetIntersectionTypeEXT(query,true) != gl_RayQueryCommittedIntersectionNoneEXT;
}
bool alphaTested(Material m) {
    int model = int(m.base.w);
    return model == MODEL_PBR || model == MODEL_HAIR || model == MODEL_EYE;
}
// Opacity from the material, UV and side alone: the Opacity pin, else the
// base colour's alpha, through one graph evaluation.
float opacityAt(Material m, vec2 uv, bool front) {
    if (m.alpha.z != 0 || !alphaTested(m) || (m.alpha.y == 0 && !front)) return 1;
    bool pin = m.programs[4].y > 0;
    ivec4 program = pin ? m.programs[4] : m.programs[0];
    Value v = program.y > 0 ? channelValue(evaluateRoot(program, uv), program.w) : scalarValue(1);
    float a = clamp(pin ? v.colour.r : v.colour.a, 0, 1);
    // Clip is all or nothing at the cutoff; Blend lets alpha through (alpha_coverage).
    return int(m.alpha.w) == ALPHA_CLIP ? (a < m.alpha.x ? 0 : 1) : a;
}
float opacity(Hit hit) { return opacityAt(materials[hit.material], hit.uv, hit.front); }
// The opacity of a shadow ray's crossing, straight from the ray-query
// candidate: its material, UV and the side it was hit from. Looking through
// a hair card needs no surfaceHit (normals, tangent frame, inverse matrix).
float crossingOpacity(int id, int primitive, vec3 local, vec2 bary, vec3 objectDirection) {
    Instance inst = instances[id];
    ivec4 geom = geometries[inst.data.x];
    vec3 ng;
    vec2 uv;
    int material;
    if (geom.w != 0) {
        ng = safeNormal(local, vec3(0, 1, 0));
        uv = vec2((atan(-ng.z, ng.x) + PI) / (2 * PI), acos(clamp(-ng.y, -1, 1)) / PI);
        material = int(materialMaps[inst.data.y]);
    } else {
        int start = geom.x + primitive * 3;
        vec3 a = vertices[start].position.xyz, b = vertices[start + 1].position.xyz, c = vertices[start + 2].position.xyz;
        vec3 w = vec3(1 - bary.x - bary.y, bary.x, bary.y);
        uv = vertices[start].uv.xy * w.x + vertices[start + 1].uv.xy * w.y + vertices[start + 2].uv.xy * w.z;
        ng = cross(b - a, c - a);
        material = int(materialMaps[inst.data.y + int(slots[geom.y + primitive])]);
    }
    // Normals transform by the inverse transpose, so facing is the same in object space.
    return opacityAt(materials[material], uv, dot(ng, objectDirection) < 0);
}
// Just past a hit along the same ray: a few float steps, so a surface
// right behind a transparent one (an eyeball under its occlusion shell) is
// still found. A fixed .001 step jumped over anything within a millimetre.
float past(float t) { return t + max(1e-6, abs(t) * 4.7683716e-7); }
// Transmittance toward a light: the product of 1 - opacity over every
// surface the ray crosses before maxT. One ray query walks the acceleration
// structure once and offers each crossing as a candidate. The order does not
// matter to a product, so none is committed, and the walk stops once the
// light is blocked. (Restarting a query past each transparent hit, as before,
// re-traversed the scene once per hair card a shadow ray crossed.)
// skip names a triangle (instance, primitive) the ray passes through, or -1.
float visibility(vec3 origin, vec3 direction, float maxT, ivec2 skip) {
    if (maxT <= .001) return 1;
    bool fast = (cfg.options.w & 2) != 0 && skip.x < 0;
    if (fast && blockedByOpaque(origin,direction,maxT)) return 0;
    if (fast && (cfg.options.w & 1) != 0) return 1;
    float value = 1;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, world, gl_RayFlagsNoOpaqueEXT, fast ? 2u : 255u, origin, .001, direction, maxT);
    while (rayQueryProceedEXT(query)) {
        int id = rayQueryGetIntersectionInstanceCustomIndexEXT(query, false);
        int primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
        vec3 o = rayQueryGetIntersectionObjectRayOriginEXT(query, false);
        vec3 d = rayQueryGetIntersectionObjectRayDirectionEXT(query, false);
        bool sphere = rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionAABBEXT;
        // A sphere's candidate is its box: weigh both of its crossings.
        vec2 t = vec2(rayQueryGetIntersectionTEXT(query, false), -1);
        if (sphere) {
            float a = dot(d, d), b = dot(o, d), discriminant = b * b - a * (dot(o, o) - 1);
            float root = sqrt(max(discriminant, 0));
            t = discriminant >= 0 ? vec2(-b - root, -b + root) / a : vec2(-1);
        } else if (id == skip.x && primitive == skip.y) {
            continue;
        }
        vec2 bary = sphere ? vec2(0) : rayQueryGetIntersectionBarycentricsEXT(query, false);
        for (int k = 0; k < 2; ++k) {
            if (t[k] > .001 && t[k] < maxT) value *= 1 - crossingOpacity(id, primitive, o + t[k] * d, bary, d);
        }
        if (value <= 1e-6) {
            rayQueryTerminateEXT(query);
            return 0;
        }
    }
    return value;
}

// The surface a path ray stops at. Instances with alpha-tested materials are
// non-opaque in the acceleration structure, so each of their crossings is a
// candidate, kept with probability equal to its opacity; the query keeps the
// nearest kept one. One traversal finds the nearest surface that passes its
// alpha test, as the CPU's sequence of pass-through events does, instead of
// restarting from the top of the BVH past every transparent hair card.
bool traceSurface(vec3 origin, vec3 direction, out Hit hit) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, world, gl_RayFlagsNoneEXT, 255u, origin, .001, direction, 1e30);
    while (rayQueryProceedEXT(query)) {
        int id = rayQueryGetIntersectionInstanceCustomIndexEXT(query, false);
        int primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, false);
        vec3 o = rayQueryGetIntersectionObjectRayOriginEXT(query, false);
        vec3 d = rayQueryGetIntersectionObjectRayDirectionEXT(query, false);
