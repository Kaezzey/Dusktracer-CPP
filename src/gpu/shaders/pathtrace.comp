            float limit = rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT
                              ? 1e30 : rayQueryGetIntersectionTEXT(query, true);
            float root = sqrt(max(discriminant, 0));
            // Nearer crossing first; the first one kept is the sphere's hit.
            for (int k = 0; k < 2 && discriminant >= 0; ++k) {
                float t = (-b + (k == 0 ? -root : root)) / a;
                if (t <= .001 || t >= limit) continue;
                float kept = crossingOpacity(id, 0, o + t * d, vec2(0), d);
                if (kept >= 1 || (kept > 0 && random() < kept)) {
                    rayQueryGenerateIntersectionEXT(query, t);
                    break;
                }
            }
        } else {
            float kept = crossingOpacity(id, primitive, o + rayQueryGetIntersectionTEXT(query, false) * d,
                                         rayQueryGetIntersectionBarycentricsEXT(query, false), d);
            if (kept >= 1 || (kept > 0 && random() < kept)) rayQueryConfirmIntersectionEXT(query);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return false;
    }
    int id = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
    float t = rayQueryGetIntersectionTEXT(query, true);
    vec3 p = rayQueryGetIntersectionObjectRayOriginEXT(query, true) +
             t * rayQueryGetIntersectionObjectRayDirectionEXT(query, true);
    vec2 bary = geometries[instances[id].data.x].w != 0 ? vec2(0) : rayQueryGetIntersectionBarycentricsEXT(query, true);
    hit = surfaceHit(id, rayQueryGetIntersectionPrimitiveIndexEXT(query, true), p, bary, direction);
    hit.p = origin + t * direction;
    hit.distance = t;
    return true;
}

// Light crossing the receiver's own body to a back-facing direction, as on
// the CPU: thickness to its surface nearest the light, other blockers by opacity.
float bodyVisibility(Hit receiver, vec3 origin, vec3 direction, float maxT, float distance) {
    float other = 1, thickness = 0, minT = .001;
    Hit hit;
    for (int i = 0; i < 1024 && minT < maxT && traceRange(origin, direction, minT, maxT, hit); ++i) {
        if (hit.instance == receiver.instance && hit.material == receiver.material) {
            thickness = hit.distance;
        } else {
            other *= 1 - opacity(hit);
            if (other <= 1e-6) {
                return 0;
            }
        }
        minT = past(hit.distance);
    }
    return other * exp(-thickness / distance);
}
float diffusionProfile(float radius,float distance) {
    radius=max(radius,1e-12);
